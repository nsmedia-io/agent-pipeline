{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-pipeline/tasks.schema.json",
  "title": "Tasks",
  "description": "Phase 3 task breakdown maintained by Dev.",
  "type": "object",
  "required": ["issue_number", "tasks"],
  "properties": {
    "issue_number": {"type": "integer"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]+$"},
          "description": {"type": "string"},
          "files_touched": {"type": "array", "items": {"type": "string"}},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["pending", "in-progress", "done", "blocked"]},
          "assigned_to": {"type": "string", "enum": ["dev", "qa", "dev+qa"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
